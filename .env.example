# Backend origin. The browser calls this app's /api/v1/*, which Next.js rewrites to this URL.
API_BASE_URL=https://projectname-api.onrender.com

# API path prefix (leave as is unless the backend version changes)
NEXT_PUBLIC_API_PREFIX=/api/v1

# Only if the backend runs with ENCRYPTION_ENABLED=true (not implemented in the starter)
NEXT_PUBLIC_ENCRYPTION_ENABLED=false
